# Optional: structured logging (all Go binaries — see .agent/epics/phase_1/logging/epic_P1_logging.md)
# LOG_LEVEL=info
# APP_VERSION=dev

# Database
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=changeme
POSTGRES_DB=portfolio
DATABASE_URL=postgres://portfolio:changeme@db:5432/portfolio?sslmode=disable

# Broker selection (MVP: Coinbase read for ingest + dashboard broker context)
BROKER_PROVIDER=coinbase
BROKER_ENV=paper

# Service-specific broker routing for Docker Compose
INGEST_BROKER_PROVIDER=coinbase
INGEST_BROKER_ENV=paper
PORTFOLIO_BROKER_PROVIDER=coinbase
PORTFOLIO_BROKER_ENV=paper

# Coinbase read API (required for real snapshots / quotes — ingest + signals).
# Key: CDP API key name (UUID or organizations/.../apiKeys/...).
# Secret: ECDSA PEM (ES256) recommended for App + Advanced Trade REST. Ed25519 base64 (64 bytes) may be rejected by Coinbase for some App endpoints.
COINBASE_READ_API_KEY=
COINBASE_READ_API_SECRET=

# Backlog: Coinbase trade keys + trading-worker / MCP order routes (requires TRADING_ENABLED=true)
COINBASE_TRADE_API_KEY=
COINBASE_TRADE_API_SECRET=
TRADING_BROKER_PROVIDER=coinbase
TRADING_BROKER_ENV=paper
TRADING_ENABLED=false
TRADING_KILL_SWITCH=false
TRADING_MAX_NOTIONAL=1000
TRADING_RESERVE=300
TRADING_MIN_HOLDINGS=BTC-USD:0.0075,SOL-USD:4
TRADING_GLOBAL_MAX_EXPOSURE=5000
TRADING_SYMBOL_COOLDOWN=5m
TRADING_ALLOWED_PROVIDERS=coinbase
TRADING_ALLOWED_SYMBOLS=BTC-USD,ETH-USD
TRADING_DENIED_SYMBOLS=

# Auth (portfolio-api)
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme
AUTH_SECRET=changeme-32-char-min

# Internal API (ingest/signals → portfolio-api; required — portfolio-api refuses empty)
INTERNAL_API_KEY=changeme
MCP_SCHEMA_VERSION=v1

# Ingest
INGEST_INTERVAL=10m
PORTFOLIO_API_URL=http://portfolio-api:8080

# Signals
SIGNAL_MOVE_THRESHOLD_PCT=2.5
SIGNAL_COOLDOWN=1h
SIGNAL_INTERVAL=5m
# IANA timezone for signals JSON log timestamps (docker: TZ on signals service)
SIGNAL_TZ=America/Detroit
SIGNAL_STATE_PATH=./data/signal-state.json
SIGNAL_RULES_PATH=./config/signals.yaml
SIGNAL_RULE_DEDUP_PATH=./data/signal-rules-dedup.json
SIGNAL_RULE_COOLDOWN=24h
# Max shadow-agent decisions per symbol per 24h (0 = unlimited)
SIGNAL_AGENT_MAX_PER_SYMBOL_24H=2
SIGNALS_WS_ENABLED=false
COINBASE_WS_URL=wss://advanced-trade-ws.coinbase.com

# The Agent (in-process LLM, shadow mode — no order placement)
# AGENT_ENABLED=false disables the agent worker; portfolio rules and price-move alerts still persist to recent_alerts.
AGENT_ENABLED=false
AGENT_PROVIDER=mock
AGENT_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=
AGENT_DAILY_COST_CAP_USD=5
AGENT_DAILY_TIMER_UTC=12:00
AGENT_CONCURRENCY=2
AGENT_PROMPT_PATH=config/agent-prompt.md
# Trade execution gate for the agent (separate from TRADING_ENABLED on portfolio-api).
# Set true only after: TRADING_ENABLED=true on portfolio-api, trading-worker running,
# and paper soak complete. Use docker-compose.coinbase.yml override which sets this automatically.
AGENT_TRADE_ENABLED=false
AGENT_MIN_TRADE_CONFIDENCE=0.70
# USD notional fallback when agent omits sizingHintNotional; 0 = require agent hint
AGENT_DEFAULT_TRADE_NOTIONAL=0

# portfolio-api: origins allowed for *direct* browser calls to :8080 (only if you set NEXT_PUBLIC_API_URL)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Web (Next.js): server-side rewrite target for /api-go → portfolio-api (Docker Compose default below)
PORTFOLIO_API_INTERNAL_URL=http://portfolio-api:8080

# Optional: if set, browser calls this URL instead of same-origin /api-go (then CORS + NEXT_PUBLIC must match your LAN)
# NEXT_PUBLIC_API_URL=
