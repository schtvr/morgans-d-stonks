# =============================================================================
# LAYER 01 — Platform (optional)
# =============================================================================
#
#   Observability — all Go binaries (see .agent/epics/phase_1/logging/epic_P1_logging.md)
#
# LOG_LEVEL=info
# APP_VERSION=dev

# =============================================================================
# LAYER 02 — Data plane
# =============================================================================
#
#   Postgres — docker-compose `db` service credentials
#
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=changeme
POSTGRES_DB=portfolio
#
#   Postgres — application URL (used by portfolio-api, trading backlog)
#
DATABASE_URL=postgres://portfolio:changeme@db:5432/portfolio?sslmode=disable

# =============================================================================
# LAYER 03 — Security & identity
# =============================================================================
#
#   portfolio-api — dashboard login (session cookie + optional bearer for cross-origin)
#
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme
AUTH_SECRET=changeme-32-char-min
#
#   Service-to-service — ingest & signals → portfolio-api (required; empty key is rejected)
#
INTERNAL_API_KEY=changeme
#
#   MCP trade schema — only used when TRADING_ENABLED=true (backlog)
#
MCP_SCHEMA_VERSION=v1

# =============================================================================
# LAYER 04 — Broker & market data (MVP: Coinbase read)
# =============================================================================
#
#   Defaults — used when a service does not override via compose
#
BROKER_PROVIDER=coinbase
BROKER_ENV=paper
#
#   Per-service routing — Docker Compose injects these per binary
#
INGEST_BROKER_PROVIDER=coinbase
INGEST_BROKER_ENV=paper
PORTFOLIO_BROKER_PROVIDER=coinbase
PORTFOLIO_BROKER_ENV=paper
#
#   Coinbase — read API (balances, spot prices; ingest snapshots + signals quotes)
#
COINBASE_READ_API_KEY=
COINBASE_READ_API_SECRET=

# =============================================================================
# LAYER 05 — Ingest service
# =============================================================================
#
#   Scheduler & API target
#
INGEST_INTERVAL=10m
PORTFOLIO_API_URL=http://portfolio-api:8080

# =============================================================================
# LAYER 06 — Signals service (crypto alerts)
# =============================================================================
#
#   Alert thresholds & cadence
#
SIGNAL_MOVE_THRESHOLD_PCT=1.0
SIGNAL_COOLDOWN=15m
SIGNAL_INTERVAL=5m
#
#   Local state — followed-symbol price history / dedup (path inside container when using compose volume)
#
SIGNAL_STATE_PATH=./data/signal-state.json
#
#   Future / optional websocket collector (not required for MVP ticker + REST quotes)
#
SIGNALS_WS_ENABLED=false
COINBASE_WS_URL=wss://advanced-trade-ws.coinbase.com
#
#   Discord — OpenClaw-friendly channel webhook (summary + fenced crypto_signal_v1 JSON)
#
DISCORD_WEBHOOK_URL=
# Optional: raw mention substring for pings (e.g. "<@123456789012345678>" from Developer Mode → Copy User ID)
DISCORD_SIGNAL_BOT_MENTION=

# =============================================================================
# LAYER 07 — Web dashboard (Next.js)
# =============================================================================
#
#   Server-side rewrite — `/api-go/*` → portfolio-api (Docker default)
#
PORTFOLIO_API_INTERNAL_URL=http://portfolio-api:8080
#
#   CORS — only if browser calls portfolio-api directly (port 8080); not needed for same-origin /api-go
#
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
#
#   Client — optional direct API origin (must match CORS + LAN if set)
#
# NEXT_PUBLIC_API_URL=

# =============================================================================
# LAYER 08 — Backlog (not default MVP compose)
# =============================================================================
#
#   IBKR — equities broker; `ib-gateway` not started by default compose
#
# IBKR_GATEWAY_HOST=ib-gateway
# IBKR_GATEWAY_PORT=4001
# IBKR_MODE=mock
# BROKER_PROVIDER=ibkr
# INGEST_IBKR_MODE=mock
#
#   Trading execution — enable `/internal/orders`, `/mcp/v1/trades`, and optional `trading-worker`
#   via `docker compose -f docker-compose.yml -f docker-compose.coinbase.yml`
#
COINBASE_TRADE_API_KEY=
COINBASE_TRADE_API_SECRET=
TRADING_BROKER_PROVIDER=coinbase
TRADING_BROKER_ENV=paper
TRADING_ENABLED=false
TRADING_KILL_SWITCH=false
TRADING_MAX_NOTIONAL=1000
TRADING_RESERVE=0
TRADING_GLOBAL_MAX_EXPOSURE=5000
TRADING_SYMBOL_COOLDOWN=5m
TRADING_ALLOWED_PROVIDERS=coinbase
TRADING_ALLOWED_SYMBOLS=BTC-USD,ETH-USD
TRADING_DENIED_SYMBOLS=
